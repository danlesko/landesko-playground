# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local-only seed helpers. The _lib prefix keeps them out of the App Router's
# route tree, so they cannot resolve to a public endpoint even if committed.
# They carry seed rows, so every location they have ever lived in stays listed
# to keep an accidental `git add` of a stale or relocated copy ignored.
src/app/_lib/seed/seed-data.ts
src/app/_lib/seed/route.ts
src/app/lib/seed/seed-data.ts
src/app/lib/seed/route.ts
src/lib/seed/seed-data.ts
src/lib/seed/route.ts


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Coding-agent scratch checkouts. Registering one as a worktree does not hide it
# from `git status`, so without this every agent run leaves the directory sitting
# untracked, one `git add .` away from committing a duplicate of the tree. This
# also keeps Prettier out, which reads .gitignore and otherwise descends into
# dot-directories. Only the worktrees directory is listed, leaving room to track
# agent config alongside the code later.
/.claude/worktrees/
