# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local-only seed helpers. The _lib prefix keeps them out of the App Router's
# route tree, so they cannot resolve to a public endpoint even if committed.
# The old src/app/lib/seed paths stay listed so an accidental `git add` of a
# stale copy is still ignored.
src/app/_lib/seed/seed-data.ts
src/app/_lib/seed/route.ts
src/app/lib/seed/seed-data.ts
src/app/lib/seed/route.ts


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
